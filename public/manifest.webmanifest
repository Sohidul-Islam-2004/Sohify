{
  "name": "Sohify",
  "short_name": "Sohify",
  "description": "Stream music, upload your own tracks and build playlists.",
  "start_url": "/Dashboard/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b0a12",
