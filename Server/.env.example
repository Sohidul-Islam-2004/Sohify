# ── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:5000
# Only needed if another website must call this API (comma-separated)
# CORS_ORIGINS=https://example.com

# ── MongoDB ────────────────────────────────────────────
DB_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/sohify

# ── Supabase Storage (audio, covers, avatars) ──────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_BUCKET=sohify

# ── Google SMTP (sign-up codes + forgot password) ──────
# Use a Google App Password, not your normal Gmail password:
#   Google Account → Security → 2-Step Verification → App passwords
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=abcd efgh ijkl mnop
# Optional (defaults shown)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
